<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ score.title }}{% if score.artist %} - {{ score.artist }}{% endif %}</title>
<style>
  :root { --ink: #111; --muted: #666; --note: #1d4ed8; }
  html, body { margin: 0; padding: 0; background: #fff; color: var(--ink); font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 11pt; }
  .sheet { width: 182mm; margin: 0 auto }
  .sheet { padding: 8mm 0; }
  header.sheet-head { border-bottom: 2px solid var(--ink); padding-bottom: 4mm; margin-bottom: 4mm; }
  header h1 { font-size: 22pt; margin: 0 0 2px 0; }
  header .artist { font-size: 13pt; color: var(--muted); margin: 0 0 6px 0; }
  header .provenance { font-size: 10pt; margin-top: -4px; }
  .facts { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 10pt; }
  .facts b { font-weight: 600; }
  .note { color: var(--note); font-size: 9.5pt; margin-top: 4px; }
  h3.legend-head { font-size: 11pt; margin: 0 0 2px 0; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 10px; margin: 2mm 0 5mm 0; break-inside: avoid; }
  .legend svg { display: block; }
  .passing, .power-note { font-size: 10pt; margin: -3mm 0 5mm 0; }
  .tab-legend { font-size: 10pt; margin: -3mm 0 5mm 0; }
  .section { margin-bottom: 5mm; }
  .section-head { margin: 0 0 1.5mm 0; break-inside: avoid; }
  .section-head { break-after: avoid }
  .section-title { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; break-inside: avoid; }
  .section-title h2 { font-size: 13pt; margin: 0; }
  .strum-label { font-size: 9pt; color: var(--muted); }
  .line { display: flex; gap: 1.5mm; break-inside: avoid; margin-bottom: 1.5mm }
  .line { align-items: flex-start; }
  .line svg { display: block; flex: 0 1 auto; min-width: 0; height: auto; }
  .repeat { margin-left: auto; padding-left: 2mm; align-self: center; flex: none; white-space: nowrap; font-size: 10pt; font-weight: 600; }
  .no-print { background: #fef3c7; padding: 6px 10px; margin-bottom: 8px; font-size: 10pt; }
  @page { size: A4; margin: 14mm }
  @media print {
    html, body { width: 182mm }
    .sheet { width: auto; padding: 0; margin: 0; }
    .no-print { display: none }
  }
</style>
</head>
<body>
<div class="sheet">
  <div class="no-print">Screen preview. Print this page, or open sheet.pdf, for the A4 layout.</div>
  <header class="sheet-head">
    <h1>{{ score.title }}</h1>
    {% if score.artist %}<p class="artist">{{ score.artist }}</p>{% endif %}
    {% if score.provenance %}<p class="artist provenance">uploaded by {{ score.provenance }}</p>{% endif %}
    <div class="facts">
      <span><b>Key</b> {{ key_fact }}</span>
      <span><b>Capo</b> {{ capo }}</span>
      <span><b>Tempo</b> {{ tempo }} bpm</span>
      <span><b>Tuning</b> {{ tuning }}</span>
      <span><b>Tier</b> {{ score.tier }}</span>
      <span><b>Meter</b> {{ score.meter.numerator }}/{{ score.meter.denominator }}</span>
    </div>
    {% if filled_note is not none %}<div class="note">{{ filled_note }}</div>{% endif %}
    {% if capo_note is not none %}<div class="note">{{ capo_note }}</div>{% endif %}
    {% if sounding_key is not none %}<div class="note">Sounding key: {{ sounding_key }}</div>{% endif %}
    {% if score.strum_source == "mix" %}<div class="note">Strum detected from full mix; directions are a best guess.</div>{% endif %}
    {% if score.strums_uncertain %}<div class="note">Strum detection uncertain for this song (onsets fit the beat grid poorly)</div>{% endif %}
  </header>

  <h3 class="legend-head">Chords</h3>
  <div class="legend">
    {% for svg in diagrams %}{{ svg }}{% endfor %}
  </div>
  {% if passing is not none %}
  <p class="passing">Passing: {{ passing }}</p>
  {% endif %}
  {% if without_capo is not none %}
  <p class="passing without-capo">Without a capo: {{ without_capo }}</p>
  {% endif %}
  {% for line in power_lines %}
  <p class="power-note">{{ line }}</p>
  {% endfor %}
  {% if tab_legend is not none %}
  <p class="tab-legend">{{ tab_legend }}</p>
  {% endif %}
  {% for line in editorial_legend %}
  <p class="tab-legend editorial">{{ line }}</p>
  {% endfor %}

  <div class="sections">
  {% for section in sections %}
    <section class="section">
      <div class="section-head">
        <div class="section-title">
          <h2>{{ section.label }}</h2>
          {% if section.state is not none %}
          <span class="strum-label">{{ section.state }}</span>
          {% endif %}
          {% if section.octave is not none %}
          <span class="strum-label octave">{{ section.octave }}</span>
          {% endif %}
        </div>
      </div>
      {% for line in section.lines %}
      <div class="line">
        {% for svg in line.svgs %}{{ svg }}{% endfor %}
        {% if line.repeat is not none %}<span class="repeat">{{ line.repeat }}</span>{% endif %}
      </div>
      {% endfor %}
    </section>
  {% endfor %}
  </div>
</div>
</body>
</html>
