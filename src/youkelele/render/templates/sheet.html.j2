<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ score.title }}{% if score.artist %} - {{ score.artist }}{% endif %}</title>
<style>
  :root { --ink: #111; --muted: #666; --note: #1d4ed8; }
  html, body { margin: 0; padding: 0; background: #fff; color: var(--ink); font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 11pt; }
  .sheet { width: 182mm; margin: 0 auto }
  .sheet { padding: 8mm 0; }
  header.sheet-head { border-bottom: 2px solid var(--ink); padding-bottom: 4mm; margin-bottom: 4mm; }
  header h1 { font-size: 22pt; margin: 0 0 2px 0; }
  header .artist { font-size: 13pt; color: var(--muted); margin: 0 0 6px 0; }
  .facts { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 10pt; }
  .facts b { font-weight: 600; }
  .note { color: var(--note); font-size: 9.5pt; margin-top: 4px; }
  h3.legend-head { font-size: 11pt; margin: 0 0 2px 0; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 10px; margin: 2mm 0 5mm 0; break-inside: avoid; }
  .legend svg { display: block; }
  .passing { font-size: 10pt; margin: -3mm 0 5mm 0; }
  .section { margin-bottom: 5mm; }
  .section-head { margin: 0 0 1.5mm 0; break-inside: avoid; }
  .section-head { break-after: avoid }
  .section-title { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; break-inside: avoid; }
  .section-title h2 { font-size: 13pt; margin: 0; }
  .strum-label { font-size: 9pt; color: var(--muted); }
  .no-instrument { font-size: 9pt; color: var(--muted); font-style: italic; }
  .strum-box { margin: 2px 0 0 0; break-inside: avoid; }
  .strum-box svg { display: block; }
  .row { display: grid; grid-template-columns: repeat(4, 1fr) auto; break-inside: avoid; }
  .row { gap: 1.5mm; margin-bottom: 1.5mm; }
  .cell { border: 1px solid; padding: 2mm; font-size: 12pt; }
  .cell { font-weight: 600; border-radius: 2px; white-space: normal; overflow-wrap: anywhere; }
  .cell.crowded { font-size: 10pt; }
  .cell.nc { color: var(--muted); }
  .cell.filled { font-style: italic }
  .cell.pickup { grid-column: span 1; font-size: 9pt; }
  .cell.pickup { padding: 1mm; }
  .pickup-label { display: block; font-size: 7pt; font-weight: 400; font-style: italic; color: var(--muted); }
  .grid.has-pickup .row { grid-template-columns: 0.25fr repeat(4, 1fr) auto; }
  .repeat { font-size: 10pt; align-self: center; }
  .repeat { grid-column: -2; min-width: 12mm; box-sizing: border-box; text-align: right; font-weight: 600; }
  .block { position: relative; break-inside: avoid; }
  .block.span .repeat { padding-right: 3mm; }
  .block.span::after { content: ""; position: absolute; right: 0; top: 0; bottom: 1.5mm; width: 1.5mm; border: 1.5px solid var(--ink); border-left: none; }
  .no-print { background: #fef3c7; padding: 6px 10px; margin-bottom: 8px; font-size: 10pt; }
  @page { size: A4; margin: 14mm }
  @media print {
    html, body { width: 182mm }
    .sheet { width: auto; padding: 0; margin: 0; }
    .no-print { display: none }
  }
</style>
</head>
<body>
{% macro cell_class(cell) %}cell{% if cell.nc %} nc{% endif %}{% if cell.crowded %} crowded{% endif %}{% if cell.filled %} filled{% endif %}{% endmacro %}
{% macro pickup_cell(cell) %}<div class="{{ cell_class(cell) }} pickup"><span class="pickup-label">pickup</span>{{ cell.text }}</div>{% endmacro %}
<div class="sheet">
  <div class="no-print">Screen preview. Print this page, or open sheet.pdf, for the A4 layout.</div>
  <header class="sheet-head">
    <h1>{{ score.title }}</h1>
    {% if score.artist %}<p class="artist">{{ score.artist }}</p>{% endif %}
    <div class="facts">
      <span><b>Key</b> {{ key_fact }}</span>
      <span><b>Capo</b> {{ capo }}</span>
      <span><b>Tempo</b> {{ tempo }} bpm</span>
      <span><b>Tuning</b> {{ tuning }}</span>
      <span><b>Tier</b> {{ score.tier }}</span>
      <span><b>Meter</b> {{ score.meter.numerator }}/{{ score.meter.denominator }}</span>
    </div>
    {% if filled_note is not none %}<div class="note">{{ filled_note }}</div>{% endif %}
    {% if capo_note is not none %}<div class="note">{{ capo_note }}</div>{% endif %}
    {% if sounding_key is not none %}<div class="note">Sounding key: {{ sounding_key }}</div>{% endif %}
    {% if score.strum_source == "mix" %}<div class="note">Strum detected from full mix; directions are a best guess.</div>{% endif %}
    {% if score.strums_uncertain %}<div class="note">Strum detection uncertain for this song (onsets fit the beat grid poorly)</div>{% endif %}
  </header>

  <h3 class="legend-head">Chords</h3>
  <div class="legend">
    {% for svg in diagrams %}{{ svg }}{% endfor %}
  </div>
  {% if passing is not none %}
  <p class="passing">Passing: {{ passing }}</p>
  {% endif %}

  <div class="sections">
  {% for section in sections %}
    <section class="section">
      <div class="section-head">
        <div class="section-title">
          <h2>{{ section.label }}</h2>
          {% if section.no_instrument %}
          <span class="no-instrument">No strummed instrument detected</span>
          {% else %}
          <span class="strum-label">Strum heard in this section; covers {{ "%d" % (section.explained * 100) }}% of detected strokes. Up and down follow the beat{% if section.uncertain %} (uncertain){% endif %}{% if section.inherited_from is not none %}, same as {{ section.inherited_from }}{% endif %}</span>
          {% endif %}
        </div>
        {% if section.example is not none %}
        <div class="strum-box"><div class="worked-example">{{ section.example }}</div></div>
        {% endif %}
      </div>
      {% set grid = section.grid %}
      <div class="grid{% if grid.pickup is not none %} has-pickup{% endif %}">
      {% if grid.pickup is not none and not grid.blocks %}
        <div class="row">
          {{ pickup_cell(grid.pickup) }}
          <div class="repeat"></div>
        </div>
      {% endif %}
      {% for block in grid.blocks %}
        {% set first_block = loop.first %}
        <div class="block{% if block.repeat > 1 and block.rows|length > 1 %} span{% endif %}">
        {% for row in block.rows %}
          <div class="row">
            {% if grid.pickup is not none %}
            {% if first_block and loop.first %}
            {{ pickup_cell(grid.pickup) }}
            {% else %}
            <div class="lead"></div>
            {% endif %}
            {% endif %}
            {% for cell in row %}
            <div class="{{ cell_class(cell) }}">{{ cell.text }}</div>
            {% endfor %}
            <div class="repeat">{% if loop.last and block.repeat > 1 %}×{{ block.repeat }}{% endif %}</div>
          </div>
        {% endfor %}
        </div>
      {% endfor %}
      </div>
    </section>
  {% endfor %}
  </div>
</div>
</body>
</html>
